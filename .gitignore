.venv

# Home Assistant dev instance (scripts/dev/develop.sh) - only the template is tracked.
config/*
!config/configuration.yaml

# The HACS install testbed (scripts/dev/hacs_testbed.sh). Nothing here is a
# template: the script writes the configuration and HACS downloads the rest,
# including a copy of this integration that must never be mistaken for the
# working tree.
config-hacs/

# Generated simulator seed.

# Upstream sources cloned for reference (scripts/dev/fetch_references.sh).
.reference/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Generated only for eyeballing the brand mark, not an asset.
brand/preview.png

# Build artefacts from `python -m build`.
dist/
build/

# Register dumps and production data from real installations. These carry
# serial numbers and live household readings, and this repo is public.
# Redacted capability fingerprints are committed instead; see
# scripts/sungrow_read_only_survey/probe.py.
.testdata/

# What the two contributor tools write, beside themselves, checkout or not.
# The transcript carries the real serial and address; the documents are
# published only by being copied into doc/device-fingerprints/ deliberately.
# Neither folder tracks a .json or .log of its own.
# tests/test_survey_dependencies.py holds every name a run writes to this.
scripts/sungrow_read_only_survey/*.json
scripts/sungrow_read_only_survey/sungrow-scan-*.log
scripts/sungrow_control_test/*-control_test.json
scripts/sungrow_control_test/*-snapshot.json
