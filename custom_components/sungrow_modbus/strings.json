  "config": {
    "abort": {
      "already_configured": "Device is already configured"
    },
    "error": {
      "cannot_connect": "Failed to connect: {error}",
      "no_serial_number": "The device answered but reported no serial number.",
      "unrecognized_inverter": "The device answered with an unknown model code ({code}). Please open an issue with this code so the model can be added.",
      "legacy_package_still_loaded": "The YAML package is still running, so its entities still hold their IDs. Remove `modbus_sungrow.yaml` from your configuration — or comment out the line that includes it — then restart Home Assistant and try again. Or choose Start fresh.",
      "network_too_large": "That range holds {hosts} addresses, more than the limit of {limit}. Sweeping it would take minutes and flood the network. Narrow it to the subnet the inverter is on, usually a /24.",
      "invalid_network": "Not a network range: {error}"
    },
    "step": {
      "user": {
        "title": "Sungrow Modbus",
        "description": "How would you like to find the inverter?",
        "menu_options": {
          "search": "Search my network",
          "manual": "Enter the address myself"
        }
      },
      "entity_ids": {
        "title": "Existing entities found",
        "description": "Home Assistant found **{count} entities** from the `modbus_sungrow.yaml` package, such as `{example}`. Your recorder history, your statistics and every dashboard card are stored against those entity IDs.\n\n{status}\n\n**Migrate my existing entities** takes those IDs over. History and statistics carry on uninterrupted and your dashboards keep working unchanged. Nothing is copied and nothing is deleted.\n\n**Start fresh** gives this inverter its own IDs, such as `sensor.sh10rt_total_dc_power`. Your old history stays where it is, under the old IDs, and your dashboards keep pointing at it.\n\nEither way the entities are identical in every other respect.",
        "data": {
          "entity_ids": "Entity IDs"
        },
        "data_description": {
          "entity_ids": "This can be changed later without losing anything."
        }
      },
      "search": {
        "title": "Search my network",
        "description": "Home Assistant will try every address in this range on the Modbus port, then ask whatever answers what it is — an open port alone is not enough to call something an inverter.\n\nThe range is prefilled with the network Home Assistant is on. A `/24` takes about a second; anything much larger is rejected, because every address probed is real traffic on your network.",
        "data": {
          "network": "Network range",
          "port": "Port"
        },
        "data_description": {
          "network": "In CIDR notation, for example 192.168.1.0/24.",
          "port": "Sungrow inverters use 502. A Modbus TCP bridge may use another."
        }
      },
      "pick": {
        "title": "Inverters found",
        "description": "{count} device(s) answered and identified themselves. Names come from your router's DNS where it provides them, otherwise the address is shown.\n\nIf none of these is the inverter you meant, choose the last option and you can enter its address yourself.",
        "data": {
          "host": "Inverter"
        }
      },
      "nothing_found": {
        "title": "No inverter found",
        "description": "Nothing on **{scanned}** identified itself as a Sungrow inverter. {candidates} device(s) had the port open but did not answer as one — an open Modbus port on its own is not enough.\n\nWorth checking:\n- the inverter is on **this** network — if Home Assistant is in a container or a VM, it may be on a different one from your inverter;\n- nothing else is holding the inverter's Modbus connection. A Sungrow accepts very few at once, so another integration, a second Home Assistant, or the old YAML package still polling will block it;\n- the port is right — 502 for a direct connection, something else through a Modbus TCP bridge.\n\nYou can search a different range, type the address in yourself, or go back to the beginning.",
        "menu_options": {
          "search": "Search a different range",
          "manual": "Enter the address myself",
          "start_over": "Back to the start"
        }
      }
    }
  },
