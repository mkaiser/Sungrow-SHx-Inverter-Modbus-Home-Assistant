  "options": {
    "step": {
      "init": {
        "title": "Diagnostics",
        "description": "Settings → Devices & Services → Sungrow Modbus → **Download diagnostics** produces a file describing this setup: the model, which capabilities the inverter confirmed, which registers reported themselves unavailable, how each poll tier is doing, and why any entity was not created. Attach it to a bug report — the serial number and the host address are removed from it.",
        "data": {
          "register_dump": "Include a raw register dump"
        },
        "data_description": {
          "register_dump": "Adds every mapped register's raw value. Only useful when a value looks wrong and the decoding itself is in question. Producing it is a second full read of the register map on top of normal polling, which is slow over a WiNet-S dongle, so leave it off unless you have been asked for it."
        }
      }
    }
  }
