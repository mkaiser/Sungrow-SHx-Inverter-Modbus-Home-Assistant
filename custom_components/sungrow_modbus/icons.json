{
  "entity": {
    "button": {
      "clear_capability_test_history": {
        "default": "mdi:history"
      },
      "diagnosis_start": {
        "default": "mdi:play-circle-outline"
      },
      "diagnosis_stop": {
        "default": "mdi:stop-circle-outline"
      }
    },
    "select": {
      "diagnosis_mode": {
        "default": "mdi:clipboard-search-outline"
      }
    },
    "sensor": {
      "capability_test_status": {
        "default": "mdi:clipboard-check-multiple-outline"
      },
      "connection": {
        "default": "mdi:lan-connect"
      },
      "diagnosis_next_start": {
        "default": "mdi:calendar-clock"
      },
      "diagnosis_progress": {
        "default": "mdi:progress-clock"
      },
      "diagnosis_step": {
        "default": "mdi:format-list-checks"
      },
      "diagnosis_test_runs": {
        "default": "mdi:counter"
      }
    },
    "switch": {
      "skip_established_capability_tests": {
        "default": "mdi:debug-step-over"
      }
    }
  },
  "services": {
    "run_capability_test": {
      "service": "mdi:tune-variant"
    },
    "run_diagnosis": {
      "service": "mdi:clipboard-search-outline"
    },
    "start_inverter": {
      "service": "mdi:play"
    },
    "stop_inverter": {
      "service": "mdi:stop"
    }
  }
}
