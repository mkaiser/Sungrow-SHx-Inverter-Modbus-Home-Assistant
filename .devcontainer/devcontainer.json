{
  "name": "Sungrow Modbus Home Assistant integration",

  // Home Assistant requires Python >= 3.14.2. Microsoft's Python devcontainer
  // image ships the interpreter, git and the non-root `vscode` user, so no
  // feature has to add them. Python lives in /usr/local/python/current, whose
  // bin/ is first on PATH -- ahead of the image's own pipx tools in
  // /usr/local/py-utils, so requirements_dev.txt's pytest, mypy and ruff win.
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",

  "features": {
    // `gh`, for issues, workflow runs and the preview mirror's manual sync.
    // No apt packages: ffmpeg, libturbojpeg and libpcap serve camera, stream
    // and dhcp, which neither dev instance loads (no `default_config:`).
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "remoteUser": "vscode",

  // WireGuard inside the container, so a tunnel to another owner's inverter
  // touches only this container, never the host's network. NET_ADMIN lets
  // wg-quick create the interface and its routes; /dev/net/tun is there for
  // wireguard-go should a kernel lack the module. The confs and the script
  // that switches them live in the ~/.claude bind mount, never in the repo.
  "runArgs": ["--cap-add=NET_ADMIN", "--device=/dev/net/tun"],

  // Session handoff: bind the host's ~/.claude into the container so Claude
  // Code auth, settings, transcripts and plan files survive a rebuild and are
  // shared with sessions running on the host. A bind (not a named volume)
  // keeps both sides looking at the same state.
  //
  // The HOME/USERPROFILE pair resolves on either host: exactly one of the two
  // is set, so this works on Windows and on Linux/macOS without editing.
  //
  // Caveat: Claude Code keys project memory by workspace path, and that path
  // differs inside the container, so repo context lives in CLAUDE.md and
  // Todo.md instead - those are path-independent and
  // committed.
  //
  // The same bind keeps `gh auth login` across rebuilds: GH_CONFIG_DIR below
  // puts gh's config in a folder of its own inside it, which gh creates on
  // first login, so the host needs no folder made by hand. It is the
  // container's own login, not the host's (gh on Windows keeps that in
  // %AppData%\GitHub CLI).
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],

  // VS Code copies the host ~/.gitconfig in when it attaches, after
  // postCreateCommand has run. On a Windows host that drags in safe.directory
  // entries like C:\..., which are not absolute paths on Linux, and git then
  // warns on every invocation, so they are dropped on every attach.
  "postCreateCommand": "scripts/dev/setup.sh",
  "postAttachCommand": "git config --global --unset-all safe.directory '^[A-Za-z]:' || true",

  "containerEnv": {
    "TZ": "Europe/Berlin",
    "GH_CONFIG_DIR": "/home/vscode/.claude/gh-devcontainer"
  },

  "forwardPorts": [8123, 5020, 8124, 8126],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    },
    // A second Home Assistant, from scripts/dev/hacs_testbed.sh, which installs
    // the integration through HACS instead of symlinking the working tree.
    // Two instances at once is the point: one is the code you are writing,
    // the other is what a user actually receives.
    "8124": {
      "label": "Home Assistant (HACS testbed)",
      "onAutoForward": "notify"
    },
    // The same on Home Assistant 2026.11, through its built-in Marketplace
    // (hacs_testbed.sh --marketplace), from a venv of its own.
    "8126": {
      "label": "Home Assistant (Marketplace testbed)",
      "onAutoForward": "notify"
    },
    "5020": {
      "label": "Sungrow Modbus simulator",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mhutchie.git-graph",
        "redhat.vscode-yaml",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true,
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
